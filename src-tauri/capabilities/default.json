{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://soundcloud.com",
      "https://soundcloud.com/*",
      "https://*.soundcloud.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-all-commands",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
